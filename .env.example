# Supabase — from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key (NEVER expose to the browser). Used for admin media deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.drsalongohamuza.com
